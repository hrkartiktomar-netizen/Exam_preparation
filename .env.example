# IFSCA Exam Prep Engine - Environment Configuration
# Copy this to .env and fill in your actual values

# ========================================
# Gemini API Keys (Required)
# Get free keys from: https://aistudio.google.com
# ========================================
GEMINI_KEY_1=your_gemini_api_key_1_here
GEMINI_KEY_2=your_gemini_api_key_2_here
GEMINI_KEY_3=your_gemini_api_key_3_here
GEMINI_KEY_4=your_gemini_api_key_4_here
GEMINI_KEY_5=your_gemini_api_key_5_here

# ========================================
# Database Configuration
# ========================================
DATABASE_PATH=/data/ifsca_exam.db
EXTRACTED_PDF_DIR=/data/extracted_pdfs

# ========================================
# Application Settings
# ========================================
DEBUG=false
LOG_LEVEL=INFO

# ========================================
# Server Settings
# ========================================
HOST=0.0.0.0
PORT=8000

# ========================================
# Optional: Logging
# ========================================
# LOG_FORMAT=json  # or 'text' for plain text logs
# LOG_FILE=/data/app.log
