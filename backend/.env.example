# OPTIONAL. On this machine the nine keys are published as user-level environment
# variables in HKCU\Environment (ADR-0003), so every work tree resolves them and no
# .env file is needed. gemini_integration.load_env_file only assigns a variable that
# is not already set, so anything here is overridden by the OS value -- use this file
# solely to give one tree different credentials.

# Key names must be exactly GEMINI_KEY or GEMINI_KEY_1..GEMINI_KEY_50, the only names
# gemini_integration.py:137-138 reads. The previous template documented
# GEMINI_API_KEY_1..5, which nothing in the code reads: following it produced a
# key-less app with no startup error, because gemini_available() simply returns False
# and mock generation fails at request time.
GEMINI_KEY_1=your_api_key_1
GEMINI_KEY_2=your_api_key_2
GEMINI_KEY_3=your_api_key_3
GEMINI_KEY_4=your_api_key_4
GEMINI_KEY_5=your_api_key_5
GEMINI_KEY_6=your_api_key_6
GEMINI_KEY_7=your_api_key_7
GEMINI_KEY_8=your_api_key_8
GEMINI_KEY_9=your_api_key_9

# Model routing. GEMINI_MODEL is the general default; the mock and accuracy paths fall
# back to it, and each thinking level falls back to GEMINI_THINKING_LEVEL.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL_MOCK=gemini-3.5-flash-lite
GEMINI_MODEL_ACCURACY=gemini-3.7-flash
GEMINI_THINKING_LEVEL=high
GEMINI_MOCK_THINKING=high
GEMINI_ACCURACY_THINKING=high

# Hours between amendment tracker sweeps (main.py:210 and main.py:3128).
UPDATE_TRACK_INTERVAL_HOURS=6

# There is no PORT variable. This is FastAPI, not Flask, and no backend module reads
# PORT -- the listen port comes from the uvicorn command line, which start.bat sets.
